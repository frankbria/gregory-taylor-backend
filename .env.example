# Gregory Taylor Backend - Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Database
# ===================
MONGODB_URI=mongodb://localhost:27017/gregory-taylor

# ===================
# Authentication (Better Auth)
# ===================
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# ===================
# Admin API Authentication
# ===================
# Optional server-only bearer token for server-to-server admin API calls.
# The admin dashboard uses the signed-in session instead. Never prefix with NEXT_PUBLIC_.
# Leave unset to disable bearer access. Generate: openssl rand -hex 32
ADMIN_API_KEY=

# ===================
# Stripe
# ===================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ===================
# Cloudinary (Image Storage)
# ===================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===================
# CORS
# ===================
# Comma-separated list of allowed origins for API requests
# Must include the frontend origin for credentialed requests (BetterAuth cookies)
# Example: https://yourdomain.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===================
# Registration Control
# ===================
# Invite code required for new user registration
# If set, users must visit /sign-up?code=YOUR_CODE to register
# Leave empty or unset to allow open registration
INVITE_CODE=
# Client-side version (must match INVITE_CODE for UI to show form)
NEXT_PUBLIC_INVITE_CODE=

# ===================
# Deployment (Production Only)
# ===================
# Port the app runs on (will be proxied by nginx)
PORT=4000
